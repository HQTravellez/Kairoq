#!/usr/bin/env node
// A stand-in for eas-cli in tests: records each call and answers like eas-cli does.
const fs=require('fs'),path=require('path');
// The log goes to a fixed file: Kairoq gives eas only EXPO_TOKEN and a few basics in its environment.
const args=process.argv.slice(2),log=require('os').tmpdir()+'/kairoq-eas-fake.log';
const snap={args,files:fs.readdirSync(process.cwd()),eas:fs.existsSync('eas.json')?JSON.parse(fs.readFileSync('eas.json','utf8')):null,creds:fs.existsSync('credentials.json')?JSON.parse(fs.readFileSync('credentials.json','utf8')):null,app:JSON.parse(fs.readFileSync('app.json','utf8')),ignore:fs.existsSync('.easignore')?fs.readFileSync('.easignore','utf8'):'',token:Boolean(process.env.EXPO_TOKEN),cwd:process.cwd()};
if(log)fs.appendFileSync(log,JSON.stringify(snap)+'\n');
const state=process.env.KAIROQ_EAS_STATE||'FINISHED';
if(args[0]==='init'){const a=snap.app;a.expo.extra={eas:{projectId:'proj-123'}};fs.writeFileSync('app.json',JSON.stringify(a));console.log(JSON.stringify({id:'proj-123'}));process.exit(0)}
if(args[0]==='build'){console.log(JSON.stringify([{id:'build-'+args[2],platform:args[2].toUpperCase(),status:'NEW',project:{slug:snap.app.expo.slug,ownerAccount:{name:'ka'}}}]));process.exit(0)}
if(args[0]==='build:view'){console.log(JSON.stringify({id:args[1],status:state,artifacts:{buildUrl:'https://expo.dev/artifacts/eas/'+args[1]+'.aab'}}));process.exit(0)}
if(args[0]==='submit'){console.log('Submitted your app');process.exit(0)}
process.exit(1);
