{
  "name": "kairoq-outcome-agents",
  "version": "16.0.0",
  "private": true,
  "description": "Kairoq v16: AI Sales Agent and AI Marketing Agent with evidence-grounded lead research, optional OpenEnrich enrichment, content generation/review, media creation, and approval-gated Postiz publishing.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
