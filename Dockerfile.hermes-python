# Kairoq Python agent, runs the *whole* unmodified MIT Hermes source.
# Pin git commit, retain upstream LICENSE and repository history.
FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone https://github.com/NousResearch/hermes-agent.git hermes \
    && cd hermes \
    && git checkout 5894e750c3dba980d43b25aa29e3958149ba2c61 \
    && test -f LICENSE
RUN python -m pip install --no-cache-dir /opt/hermes
WORKDIR /app
COPY python/hermes_gateway.py /app/hermes_gateway.py
ENV HERMES_SOURCE=/opt/hermes PYTHONUNBUFFERED=1 PORT=8090
EXPOSE 8090
CMD ["python","/app/hermes_gateway.py"]
