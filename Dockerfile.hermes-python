# Use NousResearch's fully provisioned Hermes image, including its pinned
# Python environment and browser/runtime dependencies. A plain pip install
# from the source checkout does not provision the upstream runtime.
# The image tag must be pinned to a verified digest before production release.
FROM nousresearch/hermes-agent:latest
USER root
WORKDIR /app
COPY python/hermes_gateway.py /app/hermes_gateway.py
ENV HERMES_SOURCE=/opt/hermes PYTHONUNBUFFERED=1 PORT=8090
EXPOSE 8090
ENTRYPOINT ["/opt/hermes/.venv/bin/python", "/app/hermes_gateway.py"]
