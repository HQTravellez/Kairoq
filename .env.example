
# ============================================================
# ZERO COST AI — Hermes-style local-first inference
# ============================================================
# ON by default. Kairoq tries your local Ollama/llama.cpp endpoint first,
# then OpenRouter's FREE router only if local inference is unavailable.
ZERO_COST_MODE=true

# Paid text models are HARD LOCKED unless this is explicitly enabled.
PAID_LLM_ENABLED=false

# OpenRouter free router is a fallback only. It has rate limits.
OPENROUTER_FREE_FALLBACK_ENABLED=true

# OpenRouter web_search can be billed separately even with a free model.
# Keep false for strict zero-cost text usage.
OPENROUTER_WEB_SEARCH_ENABLED=false

# Ollama exposes an OpenAI-compatible API here by default.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional: leave blank to auto-detect the first loaded local model.
# Examples: qwen3.5:4b, qwen3.5:9b, gemma4:31b
LOCAL_LLM_MODEL=

# For Kairoq agents, use a model with tool-calling support.
# Leave blank to use LOCAL_LLM_MODEL / auto-detected model.
LOCAL_LLM_TOOL_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=300000

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Hermes Agent chat (docs/HERMES.md). When both are set, the owner's chat is
# answered by the Kairoq Hermes service; the routes above are the fallback.
# KAIROQ_HERMES_KEY must equal API_SERVER_KEY on the Hermes service.
KAIROQ_HERMES_URL=
KAIROQ_HERMES_KEY=

PORT=3002
SITE_URL=http://localhost:3002
SITE_NAME=Kairoq
APP_PASSWORD=

# REQUIRED in production if you persist OAuth tokens/secrets.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Optional cloud persistence
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MEMORY_OWNER_ID=personal

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/google/callback

# Microsoft 365 — register a Web app in Microsoft Entra / Azure
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" supports work/school and personal Microsoft accounts.
# Use your tenant ID for a single-organization deployment.
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3002/api/microsoft/callback

# Core connection: User.Read + Files.ReadWrite
# Outlook adds Mail.Read, Mail.Send, Calendars.ReadWrite.
MICROSOFT_ENABLE_OUTLOOK=true

# Teams delegated APIs are for work/school accounts. Enable only when needed.
MICROSOFT_ENABLE_TEAMS=false

# SharePoint uses broader Sites.ReadWrite.All and a configured document library.
MICROSOFT_ENABLE_SHAREPOINT=false
MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_SHAREPOINT_FOLDER=Kairoq

# Kairoq restricts its OneDrive uploads to this folder in application logic.
MICROSOFT_ONEDRIVE_FOLDER=Kairoq


# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

# Nuitee / LiteAPI
NUITEE_API_KEY=

# Slack (optional)
SLACK_BOT_TOKEN=

# Shopify Admin API (optional)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Optional. Shopify's theme file API requires write_themes and Shopify's required exemption.
SHOPIFY_THEME_WRITE_ENABLED=false

# Commerce growth intelligence — read-only reporting
# Meta Marketing API: long-lived/system-user access token with the reporting access your account requires.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0

# Google Ads uses the same Google OAuth client as Gmail/Calendar.
# After setting CUSTOMER_ID, reconnect Google so the app can request the adwords scope.
# As of Sep 2026, Google Ads API access is associated with the Google Cloud project; developer-token headers are optional/ignored.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Browserless (optional browser automation)
BROWSERLESS_URL=https://production-sfo.browserless.io
BROWSERLESS_TOKEN=

# Notifications
NOTIFY_WEBHOOK_URL=

# Optional approved generic webhook
AGENT_WEBHOOK_URL=

# Cost/rate controls
DAILY_COST_LIMIT_USD=10
MONTHLY_COST_LIMIT_USD=150
REQUESTS_PER_MINUTE=30
MAX_AGENT_TOOL_LOOPS=8
MAX_DELEGATIONS=2


# Media generation router
# Images use OpenRouter first (same key as chat), then Pollinations, then fal fallback.
MEDIA_PROVIDER_ORDER=openrouter,pollinations,fal

# OpenRouter image generation/editing
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_IMAGE_EDIT_MODEL=google/gemini-3.1-flash-image

# Pollinations (optional for image fallback; required for video)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_VIDEO_MODEL=bytedance/seedance-2.0-fast

# fal.ai is optional image fallback only
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev


# Self-hosted open-source media server (recommended when you rent a GPU)
# Expected OpenAI-style endpoints:
#   POST /v1/images/generations
#   POST /v1/images/edits
#   POST /v1/videos/generations
# Creative Engine — local/free routes
LOCAL_SDCPP_ENABLED=false
LOCAL_SDCPP_BINARY=
LOCAL_SDCPP_MODEL_PATH=
LOCAL_SDCPP_MODEL_NAME=Local SD
LOCAL_SDCPP_MODEL_TYPE=sd1
LOCAL_SDCPP_STEPS=20
LOCAL_SDCPP_CFG=7
LOCAL_SDCPP_SAMPLER=euler_a

WAN2GP_BASE_URL=
WAN2GP_IMAGE_MODEL=qwen_image
WAN2GP_VIDEO_MODEL=wan22_t2v
WAN2GP_IMAGE_TO_VIDEO_MODEL=wan22_i2v
# Tour Builder local motion: use a small image-to-video endpoint on lower-memory Macs.
WAN2GP_TOUR_IMAGE_TO_VIDEO_MODEL=i2v-1-3B

SELF_HOST_MEDIA_BASE_URL=
SELF_HOST_MEDIA_API_KEY=

# Open-source models to run on that GPU server
QWEN_IMAGE_MODEL=Qwen/Qwen-Image
QWEN_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit
WAN_VIDEO_MODEL=Wan-AI/Wan2.2-T2V
WAN_IMAGE_TO_VIDEO_MODEL=Wan-AI/Wan2.2-I2V

# Preferred order. If self-hosting is configured, it is tried first.
MEDIA_PROVIDER_ORDER=localsd,wan2gp,selfhost,openrouter,pollinations,fal


# Atlas Anywhere — Telegram (free Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# Atlas Anywhere — WhatsApp / SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Optional allowlist; examples: +14165551234,whatsapp:+14165551234
TWILIO_ALLOWED_FROM=

# Higgsfield — optional paid media provider
# You can set one combined KEY_ID:KEY_SECRET credential or use the two fields.
# Official Higgsfield TypeScript SDK (preferred)
# KEY_ID:KEY_SECRET — keep server-side only.
HF_CREDENTIALS=

# Legacy Kairoq names kept for backward compatibility
HIGGSFIELD_CREDENTIALS=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_IMAGE_MODEL=alibaba/qwen-image-3/text-to-image
HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.5/text-to-video
HIGGSFIELD_IMAGE_TO_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video

# Listing-to-Sales branding
LISTING_BRAND_NAME=PlanURstay
LISTING_BRAND_WEBSITE=https://planurstay.com
LISTING_BRAND_PHONE=1-866-343-0689
LISTING_BRAND_EMAIL=info@planurstay.com
LISTING_BRAND_LOGO_URL=https://planurstay.com/images/logo.png
LISTING_BRAND_TAGLINE=Move-in ready homes. One rate. Nothing to arrange.

# Optional: path to ffmpeg for Tour Builder MP4/Reel exports.
# FFMPEG_PATH=ffmpeg

# Kairoq v16 — optional Sales / Marketing agent integrations
# Keep secrets local or in your deployment secret store. Never commit them.

# OpenEnrich is bundled. Free providers only; no enrichment secrets needed.

# Optional social publishing layer. Connect social accounts in Postiz, then put
# the Public API key in your local/deployment environment. Kairoq always asks
# for approval before scheduling a post.
POSTIZ_API_KEY=
POSTIZ_API_BASE=https://api.postiz.com/public/v1

# Experiential Labs coding gateway (server-side only)
EXPLABS_API_KEY=
# EXPlabs_API_Key is also recognized for the existing Railway setup.
# Enable the full-stack housing milestone generation + browser/revision QA.
HOUSING_APP_BUILD=false

# One-time real-model inventory app build + revision regression check (cached on volume).
FULLSTACK_APP_SMOKE_TEST=false

# Optional managed-app Supabase adapter (server-side only).
# Public URL/key alone do not activate it. The scoped RPC migration and
# server credential require approval before deployment. No service key in client files.
KAIROQ_SUPABASE_URL=
KAIROQ_SUPABASE_PUBLISHABLE_KEY=
KAIROQ_SUPABASE_ADMIN_TOKEN=

# App builder model spend. paid-first uses a strong paid coding model first and
# falls back to free models when it fails or the builder budget is used up.
# Paid builder calls only run when KAIROQ_BUILDER_PAID_APPROVED=true.
KAIROQ_BUILDER_MODE=paid-first
KAIROQ_BUILDER_PAID_APPROVED=true
KAIROQ_BUILDER_MODEL=deepseek/deepseek-v3.2
KAIROQ_BUILDER_FALLBACK_MODEL=qwen/qwen3-coder
KAIROQ_BUILDER_MONTHLY_LIMIT_USD=100

# Kairoq Create (/create): chat builder for React apps, publishing, domains and credits.
# Customers sign up at /create. The owner login (APP_PASSWORD) builds without credits.
KAIROQ_BUILDER_SIGNUPS=open
KAIROQ_FREE_CREDITS=30
KAIROQ_BUILDER_MAX_PROJECTS=50
# Optional: serve published apps at <name>.<KAIROQ_SITES_DOMAIN> (needs wildcard DNS
# *.sites-domain → Kairoq and the wildcard domain added in Railway).
KAIROQ_SITES_DOMAIN=
# Credit packs sold with Stripe Checkout. Create one-time Prices in Stripe first.
KAIROQ_STRIPE_SECRET_KEY=
KAIROQ_STRIPE_WEBHOOK_SECRET=
KAIROQ_CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":100,"price":"price_replace_me","label":"$20"}]
# Create model tiers. Pro and image (vision) requests use paid models and need
# KAIROQ_BUILDER_PAID_APPROVED=true. Model ids are OpenRouter ids, comma-separated, tried in order.
KAIROQ_PRO_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5
KAIROQ_VISION_MODELS=google/gemini-2.5-flash
# Credits per message: standard edit, Pro edit, Discuss message, extra for attached images.
KAIROQ_STANDARD_CREDITS=1
KAIROQ_PRO_CREDITS=5
KAIROQ_DISCUSS_CREDITS=1
KAIROQ_IMAGE_CREDITS=1
# After each build, open the app in headless Chromium and send runtime errors back to the model (set off to disable).
KAIROQ_RUNTIME_CHECK=on
# Create app backends: email (Resend), app owner email for owner-built apps, storage cap per app.
KAIROQ_RESEND_API_KEY=
KAIROQ_EMAIL_FROM=Kairoq Apps <apps@your-domain.com>
KAIROQ_OWNER_EMAIL=
KAIROQ_APP_STORAGE_MB=500
# Automatic HTTPS for customer domains through Railway's API. Use an account/team token
# (RAILWAY_API_TOKEN) or a project token (RAILWAY_PROJECT_TOKEN). Railway sets the *_ID values itself.
RAILWAY_API_TOKEN=
# Monthly plans (Stripe subscriptions). Each paid invoice adds the plan's credits.
# Add webhook events invoice.paid, customer.subscription.updated and customer.subscription.deleted.
KAIROQ_PLANS=[{"id":"starter","name":"Starter","credits":100,"price":"price_replace_me","label":"$20/month","features":["Pro models","Custom domains"]}]
# Parallel Vite builds (worker threads) and build timeout.
KAIROQ_BUILD_WORKERS=2
KAIROQ_BUILD_TIMEOUT_MS=90000
# Daily database backups kept under workspace/backups (or KAIROQ_BACKUP_DIR).
KAIROQ_BACKUP_DAYS=7
# Max tier (optional): the strongest, most expensive models, e.g. anthropic/claude-fable-5.1.
# Hidden until set. Needs KAIROQ_BUILDER_PAID_APPROVED=true.
KAIROQ_MAX_MODELS=
KAIROQ_MAX_CREDITS=15
# Server functions in generated apps (functions/<name>.js), run in a QuickJS sandbox.
KAIROQ_FUNCTION_WORKERS=4
KAIROQ_FUNCTION_TIMEOUT_MS=10000
# AI inside generated apps ("ai": true in src/backend.json). Billed to the app owner's credits.
KAIROQ_APP_AI_MODEL=deepseek/deepseek-v3.2
KAIROQ_APP_AI_MONTHLY_LIMIT_USD=20
KAIROQ_APP_AI_CALLS_PER_CREDIT=10
KAIROQ_APP_AI_PER_MINUTE=20
# Google sign-in for Kairoq accounts and generated apps. Register this redirect URI:
# <KAIROQ_PUBLIC_URL>/api/create/auth/google/callback  (falls back to GOOGLE_CLIENT_ID/SECRET)
KAIROQ_GOOGLE_CLIENT_ID=
KAIROQ_GOOGLE_CLIENT_SECRET=
# Real-time connections allowed per app.
KAIROQ_REALTIME_MAX_PER_APP=500
# Agent mode: steps per task and price multiplier on the tier's credits.
KAIROQ_AGENT_MAX_STEPS=15
KAIROQ_AGENT_MULTIPLIER=3
# SQL tables in generated apps: size cap, query processes and per-query time limit.
KAIROQ_APP_SQL_MB=200
KAIROQ_SQL_PROCESSES=2
KAIROQ_SQL_TIMEOUT_MS=5000
# Longest reply the AI may write in one step (tokens). Pro and Max can write whole apps at once.
KAIROQ_STANDARD_OUTPUT_TOKENS=16000
KAIROQ_PREMIUM_OUTPUT_TOKENS=32000
# Design: the AI's design brief before a new app's first build (set off to skip it),
# the free design review after a Pro/Max first build, and image generation.
KAIROQ_DESIGN_BRIEF=on
# Stronger model for design work only: the design brief and the Polish review (screenshot
# check). Tried first whatever tier wrote the code, e.g. the exact OpenRouter id of Fable.
KAIROQ_DESIGN_MODELS=
# Minimum price of a Polish review (default 5 when KAIROQ_DESIGN_MODELS is set, else 1).
KAIROQ_POLISH_CREDITS=5
# Prompt caching for Claude models (Pro, Max, design): the repeated part of each request is
# read from cache at about a tenth of the price. Set off to disable.
KAIROQ_PROMPT_CACHE=on
# Extra requests to finish a reply that hit the output limit (0-4).
KAIROQ_CONTINUATIONS=2
# Build from a reference: extra credits for the browser tests, repairs and design review
# (default twice the tier price plus one design review).
# KAIROQ_REFERENCE_CREDITS=8
# REA for deeper analysis (npm install --global rea-agents): network captures and JS/Electron app zips.
# KAIROQ_REA_COMMAND=rea
# Openly licensed photos, sounds and 3D models from Openverse and Poly Haven (off to disable).
KAIROQ_ASSET_SEARCH=on
# What one credit sells for in USD, used by the owner's cost report (Settings → AI costs).
KAIROQ_CREDIT_PRICE_USD=0.25
# Hours between runs of the saved checks on every published app (0 = off).
KAIROQ_MONITOR_HOURS=24
KAIROQ_AUTO_POLISH=on
KAIROQ_IMAGE_GENERATION=on
KAIROQ_IMAGE_MODEL=google/gemini-2.5-flash-image
KAIROQ_GENERATED_IMAGE_CREDITS=2
KAIROQ_IMAGE_COST_USD=0.05

# Modular agent stack: native Kairoq remains the authority for tools/approvals.
# ECC-inspired local recall is already active; set off to disable its extra note.
KAIROQ_ECC_RECALL=on
# Experimental read-only Mem0 OSS enrichment. No automatic conversation exports.
# Opt in only after validating the separately operated local server with synthetic data.
KAIROQ_MEM0_ENABLED=off
KAIROQ_MEM0_URL=http://127.0.0.1:8000
KAIROQ_MEM0_API_KEY=
# Each text-chat provider attempt fails over after this deadline (250..30000 ms).
# Build and vision timeouts are independent. This is not a live latency guarantee.
KAIROQ_CHAT_ATTEMPT_TIMEOUT_MS=12000
# Executor-verified, project-scoped procedural observations. Set off to stop capture/notes.
# Never starts fine-tuning, exports customer code or sends data to a training provider.
KAIROQ_VERIFIED_LEARNING=on
